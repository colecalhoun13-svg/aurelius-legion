# AURELIUS — environment template. Copy to .env and fill in.
# .env is gitignored; NEVER commit real values. In Codespaces, secrets set
# at github.com/settings/codespaces OVERRIDE .env (dotenv does not overwrite
# existing env vars) — a changed secret needs a full codespace stop/restart.

# ── Database (required) ──────────────────────────────────────────────
# Local sandbox: postgresql://aurelius:aurelius@127.0.0.1:5432/aurelius
# Production: the Neon URL (or the Mini's local Postgres after deploy)
DATABASE_URL=

# ── LLM providers (Anthropic at minimum; router degrades gracefully) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────
# "openai" or "gemini" in production · "mock" for keyless local dev.
# MUST have the matching key set, and MUST be the SAME pair on both services:
#   openai → OPENAI_API_KEY · gemini → GEMINI_API_KEY
# A provider with no key disables ALL semantic recall (it logs loudly now, but
# the old silent version is why Aurelius once looked like it had amnesia).
# Changing provider re-geometries the index — re-run:
#   npx tsx scripts/backfillEmbeddings.ts --force
EMBEDDINGS_PROVIDER=openai

# ── Telegram bridge (dormant until both are set) ─────────────────────
# Token from @BotFather — the FULL value, digits:letters, no quotes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Calendar (dormant until both are set) ─────────────────────
# WEB APPLICATION OAuth client from console.cloud.google.com (NOT "Desktop" —
# a desktop client cannot register an https redirect, and a refresh token is
# bound to the client that minted it: swapping clients kills every stored
# token with invalid_grant and you must re-connect).
# Publish the OAuth consent screen too — in "Testing" Google expires refresh
# tokens after 7 days, which reads as "the calendar randomly stopped working".
# One-time authorize at /api/calendar/auth after boot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to http://localhost:<PORT>/api/calendar/callback
# GOOGLE_REDIRECT_URI=

# ── Google Sheets (training engine) ──────────────────────────────────
GOOGLE_SHEETS_SERVICE_ACCOUNT_PATH=

# ── Second-brain bridges (dormant until set — Mini deploy step) ──────
# PAPERLESS_URL=
# PAPERLESS_TOKEN=
# Obsidian vault mirror directory:
# VAULT_DIR=

# ── Live web search (research Tier 2 + the `web` tool) ───────────────
# Either one turns on live search. Tavily is purpose-built for agents;
# GEMINI_API_KEY above also works (Google Search grounding), no new signup.
# With neither, research runs model-only and SAYS SO in its output.
# TAVILY_API_KEY=
#
# Optional research keys (Tier 1.5 academic sources need none)
# SERPAPI_KEY=

# ── Server ───────────────────────────────────────────────────────────
PORT=3001

# ── Media host (Instagram publishing) ──────────────────────────────
# Instagram fetches images from a public URL — it cannot accept an upload —
# so publishing needs somewhere to serve them from. Set this to the origin
# Aurelius is reachable at; files are served under /media.
# Unset = dormant: drafting and metrics work, publishing reports "config".
MEDIA_PUBLIC_BASE_URL=
# Optional: override where media is written (default ./vault/public-media)
MEDIA_DIR=

# ── LLM spend ──────────────────────────────────────────────────────
# Monthly ceiling in USD. Unset = spend is still tracked and reportable
# ("what are you costing me"), but no alarm fires. Set it and Aurelius
# surfaces a Bridge signal once at 80% and once at 100% each month.
# Figures are hand-maintained estimates (aurelius/llm/pricing.ts), not a
# billing feed — the provider console is the source of truth.
LLM_MONTHLY_BUDGET_USD=
