generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Operator {
  id              String    @id @default(cuid())
  name            String    @unique
  domain          String?
  priority        Int?      @default(1)
  cooldownSeconds Int?      @default(60)
  lastRunAt       DateTime?

  // Reverse relations
  memories              Memory[]
  tasks                 Task[]
  autonomyGoals         AutonomyGoal[]
  logs                  LogEntry[]
  reasoningCacheEntries ReasoningCacheEntry[]
  compiledPatterns      CompiledPattern[]
  knowledgeEntries      KnowledgeEntry[]
  projects              Project[]
  goals                 Goal[]
  habits                Habit[]
  notes                 Note[]
  dailyPlans            DailyPlan[]
  calendarEvents        CalendarEvent[]
  bridgeSignals         BridgeSignal[]
  corpusDocuments       CorpusDocument[]
}

model Memory {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  category   String
  value      String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Prompt assembly scans this table up to 11× per LLM call (final council).
  // A GIN index on metadata also exists, SQL-only — see the migration.
  @@index([operatorId, category, createdAt])
}

// Extended in place from the Phase-0 stub (data-preserving: legacy rows keep
// operatorId/title/status/metadata and pick up defaults for the new fields).
// operatorId is nullable — personal tasks ("call mom") have no operator lens.
model Task {
  id               String    @id @default(cuid())
  operatorId       String?
  operator         Operator? @relation(fields: [operatorId], references: [id])
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id])
  goalId           String?
  goal             Goal?     @relation(fields: [goalId], references: [id])
  domain           String    @default("personal")
  title            String
  description      String?
  status           String // "inbox" | "today" | "next" | "later" | "waiting" | "done" | "abandoned" (legacy rows keep their strings)
  priority         String    @default("normal") // "critical" | "high" | "normal" | "low"
  estimatedMinutes Int?
  actualMinutes    Int?
  dueDate          DateTime?
  scheduledFor     DateTime? // when Cole plans to do it
  completedAt      DateTime?
  origin           String    @default("cole") // "cole" | "aurelius_proposed" | "ritual_generated"
  originContext    Json? // for proposed tasks: why Aurelius suggested it
  metadata         Json? // legacy field, preserved
  parentTaskId     String?
  parent           Task?     @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks         Task[]    @relation("SubTasks")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([operatorId, status])
  @@index([status, scheduledFor])
  @@index([status, dueDate])
}

model AutonomyGoal {
  id          String   @id @default(cuid())
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id])
  description String
  status      String
  priority    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Conversation continuity — every chat turn persists, and the last few
// flow back into the next prompt (Layer 5.25). Without this, every
// conversation starts amnesiac and "what we just discussed" dies with
// the process.
model ConversationTurn {
  id           String   @id @default(cuid())
  role         String // "cole" | "aurelius"
  content      String
  operatorName String?
  engine       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model LogEntry {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  type       String
  level      String
  message    String
  context    Json?
  createdAt  DateTime @default(now())

  // The fastest-growing, hottest-read table: boot catch-up, the traces
  // cockpit, scoreboard llm_call aggregation, trust ledger (final council).
  @@index([type, message, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 4.5 — COMPILED UNDERSTANDING
// Two tables that turn Aurelius's experience into reusable knowledge.
// ReasoningCacheEntry stores tagged situations + prior conclusions.
// CompiledPattern stores patterns derived across similar situations.
// ═══════════════════════════════════════════════════════════════════

model ReasoningCacheEntry {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  // Modularity primitive: operator + domain as separate axes
  domain String @default("training_session")

  // Identity / scope — generalized for cross-operator use
  entityKey       String // athlete name, lead ID, post ID, etc.
  externalScopeId String // sheet ID, CRM ID, post ID — was sheetId
  subContext      String? // "Day 1", "Q4_2026", "instagram_reels" — was dayTab

  // The situation, tagged at write time using the operator's knowledge module
  situationSignature Json

  // What Aurelius concluded for this situation
  reasoningSummary String

  // Provenance + usage
  sourceMemoryIds String[]
  usageCount      Int      @default(0)

  // Re-tagging support (populated in future; v1 leaves empty)
  previousTags Json[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId, domain, entityKey])
  @@index([operatorId, entityKey, externalScopeId])
  @@index([domain])
}

model CompiledPattern {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  // Modularity primitive (matches ReasoningCacheEntry)
  domain String

  // Scope — null entityKey = cross-entity (e.g., cross-athlete)
  entityKey       String?
  externalScopeId String?

  // Pattern shape
  patternType      String // "factual" | "heuristic" | "structuralMatch"
  patternSignature Json
  conditions       Json?

  // Lifecycle status
  // auto_factual          — facts that compiled automatically (N=2)
  // proposed_heuristic    — heuristic noticed but unconfirmed (N=3)
  // confirmed_heuristic   — Cole confirmed; usable as soft rule
  // discarded             — Cole denied, kept as observation only
  status String @default("proposed_heuristic")

  // Evidence trail
  evidence        String[]
  supportCount    Int      @default(0)
  confidenceScore Float    @default(0)

  // Trust counters (outcome loop) — monotone, machine-readable, non-saturating.
  // These gate the short-circuit; the confidence float is only a floor veto.
  // validatedCount — decisions this rule informed that Cole explicitly ratified
  // ratifiedCount  — times Cole's hand explicitly endorsed (ratify/confirm)
  // correctionsSinceConfirm — corrections absorbed since Cole last confirmed
  validatedCount          Int @default(0)
  ratifiedCount           Int @default(0)
  correctionsSinceConfirm Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId, domain, entityKey])
  @@index([operatorId, status])
  @@index([domain])
}

// ═══════════════════════════════════════════════════════════════════
// PRODUCTIVITY PLANE — Cole's lane
// The whole-life second-brain entities: what Cole is executing, distinct
// from what Aurelius is doing in the background. operatorId is nullable
// throughout — personal items have no operator lens. AutonomyGoal (above)
// stays Aurelius's objectives; Goal here is Cole's. Consolidation of the
// two is deferred to the autonomy-engine rebuild, which owns that code.
// BridgeSignal is where the two lanes meet.
// ═══════════════════════════════════════════════════════════════════

model Project {
  id          String    @id @default(cuid())
  operatorId  String?
  operator    Operator? @relation(fields: [operatorId], references: [id])
  domain      String    @default("personal") // "coaching_business" | "coaching_platform" | "school" | "finance" | "content" | "personal" | "cole_training"
  name        String
  description String?
  status      String    @default("active") // "active" | "paused" | "shipped" | "abandoned"
  priority    String    @default("normal") // "critical" | "high" | "normal" | "backburner"
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goals Goal[]
  tasks Task[]

  @@index([status, priority])
  @@index([domain, status])
}

model Goal {
  id          String    @id @default(cuid())
  operatorId  String?
  operator    Operator? @relation(fields: [operatorId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  domain      String    @default("personal")
  name        String
  description String?
  measure     Json? // { type: "count" | "boolean" | "value" | "date_hit", target, current }
  horizon     String    @default("quarter") // "quarter" | "year" | "life"
  status      String    @default("active") // "active" | "hit" | "missed" | "revised"
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([status, horizon])
}

model Habit {
  id             String    @id @default(cuid())
  operatorId     String?
  operator       Operator? @relation(fields: [operatorId], references: [id])
  domain         String    @default("personal")
  name           String
  cadence        String    @default("daily") // "daily" | "weekly" | "custom_cron"
  cronExpression String?
  active         Boolean   @default(true)
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  createdAt      DateTime  @default(now())

  completions HabitCompletion[]

  @@index([active])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id])
  completedAt DateTime @default(now())
  note        String?

  @@index([habitId, completedAt])
}

model Note {
  id               String    @id @default(cuid())
  operatorId       String?
  operator         Operator? @relation(fields: [operatorId], references: [id])
  domain           String    @default("personal")
  title            String?
  content          String // markdown
  captureContext   String? // "quick_capture" | "meeting" | "reading" | "voice"
  linkedTaskIds    String[]
  linkedProjectIds String[]
  linkedMemoryIds  String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdAt])
}

model DailyPlan {
  id          String    @id @default(cuid())
  date        DateTime  @unique // day this plan is for (midnight UTC)
  operatorId  String?
  operator    Operator? @relation(fields: [operatorId], references: [id])
  generatedBy String    @default("cole_manual") // "morning_briefing" | "cole_manual" | "revised"
  headline    String? // briefing summary sentence
  focus       String? // 1-3 sentences: what today is about
  taskIds     String[] // ordered Task.id list for today
  ritualIds   String[] // linked RitualInstance ids
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ritual {
  id            String   @id @default(cuid())
  name          String   @unique // "morning_briefing" | "nightly_debrief" | "weekly_planning" | "midday_check"
  cadence       String // "daily_morning" | "daily_night" | "weekly_sunday" | "on_demand"
  scheduledTime String // "07:00" | "21:30" | "sunday_09:00"
  active        Boolean  @default(true)
  templateJson  Json?
  createdAt     DateTime @default(now())

  instances RitualInstance[]
}

model RitualInstance {
  id               String    @id @default(cuid())
  ritualId         String
  ritual           Ritual    @relation(fields: [ritualId], references: [id])
  scheduledFor     DateTime
  firedAt          DateTime?
  status           String    @default("scheduled") // "scheduled" | "generated" | "delivered" | "acknowledged" | "skipped" | "revoked"
  outputText       String?
  outputStructured Json?
  deliveredVia     String? // "push" | "in_app" | "email"
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([ritualId, scheduledFor])
  @@index([status, scheduledFor])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  externalId    String    @unique // Google event id
  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])
  domain        String    @default("personal")
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  location      String?
  attendees     Json?
  linkedTaskIds String[]
  syncedAt      DateTime  @default(now())
  raw           Json?

  @@index([startAt])
}

// The core two-lane surface. Aurelius's background work surfaces here;
// Cole's steering writes here too (kind="cole_steer").
model BridgeSignal {
  id         String    @id @default(cuid())
  kind       String // "background_result" | "cole_steer" | "gap_alert" | "proposal_batch" | "opportunity" | "risk"
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id])
  domain     String?
  sourceType String // "research_ingestion" | "compiled_pattern" | "reasoning_output" | "cole_message" | "ritual"
  sourceId   String?
  severity   String    @default("info") // "info" | "notice" | "attention" | "critical"
  title      String
  body       String // markdown
  actions    Json? // [{ label, action, payload }]
  // "pending" | "surfaced" = AWAITING A DECISION (these drive the badge)
  // "noted"     = a receipt: work happened, nothing for Cole to rule on
  // "acknowledged" | "acting" (transient confirm claim) | "acted" | "dismissed" | "expired"
  // The default is "pending" and most writers never set it, which is how 460
  // receipts came to look like 460 outstanding decisions. surfaceSignal()
  // derives the right one (core/bridge.ts::needsDecision) — prefer it over a
  // raw create for exactly this reason.
  status     String    @default("pending")
  surfacedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([kind, status])
}

// The push foundation: what Cole said mattered vs what actually happened.
model IntentActionGap {
  id          String   @id @default(cuid())
  goalId      String?
  projectId   String?
  domain      String
  windowStart DateTime
  windowEnd   DateTime
  intent      String
  action      String
  gapScore    Float // 0.0 = perfect alignment, 1.0 = complete miss
  gapSummary  String
  computedAt  DateTime @default(now())

  @@index([domain, computedAt])
}

// ═══════════════════════════════════════════════════════════════════
// SECOND BRAIN — CORPUS + MEASUREMENT
// CorpusDocument: everything ingested, registered so Aurelius is AWARE
// of what it knows (inventory injects into every prompt). Correction /
// MeasurementSnapshot / IngestionRun: the scoreboard + decay substrate.
// ═══════════════════════════════════════════════════════════════════

model CorpusDocument {
  id          String    @id @default(cuid())
  title       String
  sourceType  String    @default("note") // "upload" | "url" | "note" | "research"
  sourceUrl   String?
  domain      String    @default("personal")
  operatorId  String?
  operator    Operator? @relation(fields: [operatorId], references: [id])
  summary     String // short synopsis — what Aurelius "remembers" about it
  contentText String // full extracted text
  chunkCount  Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([domain, createdAt])
  @@index([createdAt])
}

model Correction {
  id             String   @id @default(cuid())
  operatorId     String?
  targetType     String // "compiled_pattern" | "knowledge_entry" | "reasoning_output"
  targetId       String
  correctionType String // "value_wrong" | "pattern_wrong" | "context_wrong" | "should_have_asked"
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model MeasurementSnapshot {
  id         String   @id @default(cuid())
  weekStart  DateTime
  operatorId String?
  metrics    Json // { llmDependenceRate, patternHitRate, correctionRate, coverage, gapAlignment, ... }
  createdAt  DateTime @default(now())

  @@unique([weekStart, operatorId])
}

// The acting layer (NORTH_STAR §2.5 / §6 Block 4). A grant is Cole handing
// Aurelius a scoped, reversible key to FINALIZE one inward action-class on its
// own. Outward classes (publish/send/spend) and training/health are
// non-grantable by construction (enforced in autonomy/actionClasses.ts, never
// by the row). Cole is the only writer; revoke sets status and the grant goes
// dormant. Never embedded — raw prisma only.
model AutonomyGrant {
  id          String    @id @default(cuid())
  operator    String // the operator/domain the action-class belongs to
  actionClass String // stable action-class key, e.g. "calendar.schedule_protection"
  status      String    @default("active") // "active" | "revoked"
  grantedBy   String    @default("cole")
  note        String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([operator, actionClass])
  @@index([status])
}

model IngestionRun {
  id               String    @id @default(cuid())
  runType          String // "weekend_deep" | "targeted_gap" | "ad_hoc" | "corpus_upload"
  operatorName     String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("running") // "running" | "completed" | "failed"
  sourcesQueried   Json?
  findingsCount    Int       @default(0)
  proposalsCreated Int       @default(0)
  errors           Json?
  triggeredBy      String    @default("schedule") // "schedule" | "cole" | "self_directed"

  @@index([startedAt])
}

// ═══════════════════════════════════════════════════════════════════
// THE WIKI — Aurelius's own synthesis. One living page per domain,
// written and rewritten by Aurelius from everything it has absorbed
// (corpus, memories, confirmed knowledge). Pages embed into recall, so
// synthesis compounds: tomorrow's answers stand on today's write-ups.
// ═══════════════════════════════════════════════════════════════════

model WikiPage {
  id         String   @id @default(cuid())
  slug       String   @unique // = domain, v1
  title      String
  domain     String
  content    String // markdown
  sourceRefs Json? // { corpusDocIds: [], memoryCount, knowledgeCount }
  revision   Int      @default(1)
  updatedBy  String   @default("aurelius") // "aurelius" | "cole"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  revisions WikiRevision[]
}

model WikiRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revision  Int
  content   String
  reason    String? // what triggered the rewrite
  createdAt DateTime @default(now())

  @@index([pageId, revision])
}

// ═══════════════════════════════════════════════════════════════════
// KNOWLEDGE PROPOSALS — the propose→confirm loop, durable.
// Was in-memory in v1 (died on restart); now every proposal survives
// until Cole resolves it, and the Bridge review surface reads from here.
// ═══════════════════════════════════════════════════════════════════

model KnowledgeProposal {
  id                  String    @id @default(cuid())
  operatorId          String
  operatorName        String
  intentClassId       String
  scope               String
  key                 String
  proposedValue       Json
  priorValue          Json?
  rationale           String    @default("")
  coleNaturalLanguage String    @default("")
  status              String    @default("pending") // "pending" | "confirmed" | "denied" | "corrected" | "expired"
  // Where the proposal was born ("chat"|"research"|"ingestion"|"observer"|
  // "freshness") — decides keyhole eligibility, incl. for the nightly
  // queue sweep. Null = predates the column (backlog rows).
  origin              String?
  cacheEntryId        String?
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  @@index([operatorId, status])
  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// MISSIONS — the autonomy loop that actually executes.
// Cole (or a schedule) states an objective; Aurelius plans discrete
// steps, runs them (research / recall / synthesize), and files a
// report. Reports auto-ingest into the corpus, so the second brain
// grows from its own missions. Hard rule carried: missions produce
// signals and proposals only — they never touch Living Knowledge
// directly and never act outward without Cole.
// ═══════════════════════════════════════════════════════════════════

model Mission {
  id           String    @id @default(cuid())
  title        String
  objective    String // what success looks like, in Cole's words
  domain       String    @default("personal")
  operatorName String? // lens the mission runs under (strategy default)
  origin       String    @default("cole") // "cole" | "aurelius_proposed" | "schedule"
  priority     String    @default("normal") // "low" | "normal" | "high"
  status       String    @default("proposed") // "proposed" | "planned" | "running" | "completed" | "failed" | "cancelled" | "archived" (14d-ignored proposal, may re-propose)
  planSummary  String? // one-line restatement of the approach
  report       String? // final report (markdown)
  corpusDocId  String? // report's home in the second brain
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  steps MissionStep[]

  @@index([status, createdAt])
}

model MissionStep {
  id         String    @id @default(cuid())
  missionId  String
  mission    Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  idx        Int
  kind       String // "research" | "recall" | "synthesize"
  input      String // query / instruction for this step
  status     String    @default("pending") // "pending" | "running" | "done" | "failed"
  output     String? // step result (truncated for storage)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([missionId, idx])
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 4.6 — RETRIEVAL SUBSTRATE
// Derived data: semantic index over knowledge, memory, and reasoning.
// Rebuildable at any time from source tables (scripts/backfillEmbeddings).
// The embedding column is pgvector; Prisma treats it as Unsupported, so
// all reads/writes go through raw SQL in aurelius/retrieval/vectorStore.ts.
// Dimension fixed at 1536 (OpenAI text-embedding-3-small). Switching
// embedding models = migration + re-run backfill; cheap by design.
// ═══════════════════════════════════════════════════════════════════

model VectorEmbedding {
  id             String                       @id @default(cuid())
  sourceType     String // "knowledge_entry" | "memory" | "reasoning_cache" | "note" | "corpus_doc"
  sourceId       String
  chunkIndex     Int                          @default(0)
  chunkText      String // the text that was embedded (hydration + citation)
  operatorId     String? // loose reference — embeddings are derived, no FK
  domain         String?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String
  createdAt      DateTime                     @default(now())

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([operatorId])
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 4.5a — LIVING KNOWLEDGE
// Structured, evolving domain intelligence. Updated by Cole's
// confirmed conversations and research ingestion. Provenance on
// every entry. Per-operator namespacing on a single table.
// ═══════════════════════════════════════════════════════════════════

model KnowledgeEntry {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  // Scope — namespacing within an operator's knowledge
  // e.g., scope="rep_bands", key="strength" → value={lower:4, upper:5, intent:"strength"}
  scope String // top-level category: "rep_bands", "intensity_zones", etc.
  key   String // identifier within scope: "strength", "hypertrophy", etc.
  value Json // the actual knowledge payload (structured)

  // Provenance — why does this value exist?
  // sourceType: "founding_default" | "cole_conversation" | "research_ingestion" | "manual"
  // sourceId: opaque reference (memory id, research result id, conversation turn id)
  // rationale: short human-readable explanation
  sourceType String
  sourceId   String?
  rationale  String?

  // Audit + lifecycle
  createdBy String // "system" for seeded defaults, "cole" for confirmed updates, etc.
  updatedBy String?
  version   Int     @default(1) // increments on update
  active    Boolean @default(true) // soft-disable without deletion

  // History trail — previous values preserved for audit
  // Each prior version stored as { value, sourceType, sourceId, rationale, version, replacedAt }
  history Json[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operatorId, scope, key])
  @@index([operatorId, scope])
  @@index([operatorId, active])
}

// Atomic once-per-day claim for scheduled jobs (go-live council). The catch-up
// dedup used to rest on best-effort trace telemetry — a redeploy straddling a
// cron minute could double-fire the briefing, or a killed run could count as
// done. Now: INSERT the (jobName, day) claim; only the winner runs. A claim
// stuck "running" >30 min is treated as a dead process and taken over.
model JobRun {
  id        String   @id @default(cuid())
  jobName   String
  day       String // local YYYY-MM-DD (process TZ)
  status    String   @default("running") // running | done | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobName, day])
}

// ═══════════════════════════════════════════════════════════════════
// THE CLIENT ENGINE — Cole's remote coaching business, end to end.
//
// Scope note (2026-08-05): this models the REMOTE business Cole owns. He is
// employed at the gym, so the athletes he coaches in person belong to his
// employer and never appear here. Putting them in would be modelling someone
// else's book as if it were his.
//
// The pipeline is Lead → Client → Engagement → { Session, Invoice → Payment }.
// Two deliberate splits:
//
//   • INVOICE vs PAYMENT — owed vs received. Cole asked for both, and they
//     are genuinely different questions: "who hasn't paid me" cannot be
//     answered by a ledger of what arrived. An Invoice can be partially paid
//     by several Payments, so this is one-to-many, not a status flag.
//   • ENGAGEMENT carries the money, not Client. Cole sells three shapes at
//     once (monthly retainer, fixed 8–12 week block, one-off program) and a
//     single athlete can move between them or hold more than one. Collapsing
//     price onto Client would have forced one shape to win.
//
// Money is INTEGER CENTS everywhere. Never Float — binary floating point
// cannot represent 0.10, and a revenue total that drifts is worse than none.
// ═══════════════════════════════════════════════════════════════════

// Someone who might become a client. Lives here from first contact until they
// convert or go cold — Cole has zero inbound today, so most leads will start
// as a name he typed in himself off the warm list.
model Lead {
  id       String  @id @default(cuid())
  name     String
  email    String?
  phone    String?
  // Athlete context — the lead may BE the athlete or be their parent.
  sport    String?
  gradYear Int?
  location String? // remote coaching crosses time zones; "Austin TX" is enough

  // Where they came from. Cole's honest answer today is "nowhere" — this
  // exists so the first ten tell him which channel is actually worth building.
  source     String  @default("manual") // "manual" | "referral" | "instagram" | "email" | "word_of_mouth" | "website" | "other"
  referredBy String? // free text: who sent them. The highest-converting source is also the easiest to forget to thank.

  status     String  @default("new") // "new" | "contacted" | "conversing" | "proposed" | "won" | "lost" | "dormant"
  lostReason String? // why it died — the only way a pipeline teaches anything

  // The follow-up spine. A lead with no nextAction is how a warm list goes cold.
  nextAction    String?
  nextActionAt  DateTime?
  lastContactAt DateTime?

  notes String?

  convertedClientId String?   @unique
  convertedClient   Client?   @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?

  // WHICH ANGLE BROUGHT THEM. The whole attribution chain: angle → lead →
  // client → payment. Without it Cole never learns which of his marketing
  // actually earns, and keeps guessing — the exact thing he built this for.
  angleId String?
  angle   MarketingAngle? @relation(fields: [angleId], references: [id])

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([status, nextActionAt])
  @@index([source])
}

// A converted athlete. Distinct from Lead so a lost lead can't quietly linger
// in the roster and inflate the only numbers that matter.
model Client {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?

  sport    String?
  position String?
  gradYear Int?
  timezone String? // remote delivery: a 6am check-in is not 6am for both of you

  // The buyer is frequently NOT the athlete. Cole coaches high-school athletes;
  // parents typically pay and are typically the ones who need answering.
  parentName  String?
  parentEmail String?
  parentPhone String?
  isMinor     Boolean @default(false) // gates sharing results publicly — consent for a minor is the parent's to give

  status      String    @default("active") // "active" | "paused" | "ended"
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  endedReason String?

  notes String?

  lead        Lead?
  engagements Engagement[]
  sessions    Session[]
  invoices    Invoice[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// The commercial relationship — WHAT the client bought and on what terms.
// One client may hold several over time (a block, then monthly), or more than
// one at once (monthly coaching plus a one-off program).
model Engagement {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Cole's three shapes, and the reason this table exists:
  //   "monthly" — recurring until cancelled; nextBillingAt drives the renewal.
  //   "block"   — fixed 8–12 weeks; endsAt is a real date and IS the re-sign
  //               conversation, which is the highest-value thing to be reminded of.
  //   "program" — one-off sale, no ongoing obligation; endsAt stays null.
  shape String
  title String // "Off-season speed block", "Monthly remote coaching"

  priceCents Int // per month for "monthly"; total for "block" and "program"
  currency   String @default("usd")

  startsAt      DateTime  @default(now())
  endsAt        DateTime? // set for "block"; null for open-ended monthly and one-off programs
  nextBillingAt DateTime? // "monthly" only — when the next invoice is due to be raised
  autoRenew     Boolean   @default(false)

  status String  @default("active") // "active" | "completed" | "cancelled" | "pending"
  notes  String?

  sessions Session[]
  invoices Invoice[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status, endsAt])
  @@index([status, nextBillingAt])
}

// A coaching touchpoint. Deliberately delivery-agnostic: Cole runs on Google
// Sheets and text today and wants Aurelius to become the delivery platform
// later, so this records THAT something happened, not how it was delivered.
model Session {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  kind        String    @default("check_in") // "check_in" | "call" | "video_review" | "test" | "session"
  scheduledAt DateTime?
  completedAt DateTime?
  durationMin Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, scheduledAt])
  @@index([completedAt])
}

// WHAT IS OWED. Separate from Payment on purpose — see the header note.
model Invoice {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  amountCents Int
  currency    String  @default("usd")
  description String?

  issuedAt DateTime  @default(now())
  dueAt    DateTime?
  paidAt   DateTime? // set when payments cover the full amount

  // "overdue" is NOT stored — it is dueAt < now on an unpaid invoice. A stored
  // flag would need a cron to stay honest and would be wrong between runs.
  status String @default("draft") // "draft" | "sent" | "partial" | "paid" | "void"

  externalRef String? // Stripe/PayPal id if invoicing ever moves off Cole's hands

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status, dueAt])
}

// WHAT ACTUALLY ARRIVED. May be linked to an Invoice (normal) or stand alone
// (Cole gets handed cash — recording it beats pretending it didn't happen).
model Payment {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  amountCents Int
  currency    String   @default("usd")
  receivedAt  DateTime @default(now())
  method      String   @default("other") // "cash" | "venmo" | "zelle" | "stripe" | "paypal" | "bank" | "other"
  externalRef String?
  note        String?

  createdAt DateTime @default(now())

  @@index([clientId, receivedAt])
  @@index([invoiceId])
  @@index([receivedAt])
}

// ═══════════════════════════════════════════════════════════════════
// THE MARKETING ENGINE — evidence, not guesses.
//
// Cole's stated reason for building Aurelius: marketing is what he lacks
// most, so he cannot tell a good marketing guess from a bad one. That makes
// a fluent LLM the WORST possible shape for this feature — a confident
// improvisation he has no way to audit.
//
// So an angle is a HYPOTHESIS with its evidence attached, and it is judged
// by what actually happens. Generic research gives the first bet; Cole's own
// results overwrite it. That second loop is the point: in six months, what
// happened to HIS market is worth more than every research pass combined.
// ═══════════════════════════════════════════════════════════════════

model MarketingAngle {
  id         String @id @default(cuid())
  title      String // short handle: "The parent's real fear"
  hypothesis String // what this claims will resonate, and with whom
  audience   String // who it speaks to — parent, athlete, referring coach

  // PROVENANCE. Without this the whole feature is a guess in a nice voice.
  // "external" = real sources retrieved · "internal" = the corpus/his own
  // results · "none" = model priors, and it must SAY so out loud.
  grounding String  @default("none")
  sources   Json? // [{ title, url, source }] — what it was actually built on
  rationale String? // why this should work, in terms of the evidence above

  status String @default("proposed") // "proposed" | "active" | "retired"

  // THE RESULTS LOOP. Derived truth beats researched truth the moment it
  // exists. Counters are incremented by recordOutcome, never guessed.
  timesUsed   Int @default(0)
  replies     Int @default(0)
  conversions Int @default(0)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
