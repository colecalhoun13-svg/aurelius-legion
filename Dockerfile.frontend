# Aurelius frontend — the app's permanent address (Railway service 2).
# Built from the REPO ROOT (not frontend/) because the Next API routes
# import backend modules directly (../aurelius/...), so both trees must be
# present at build time. Serves the PWA on :3000.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Deps first, both trees, for layer caching.
COPY aurelius/package*.json aurelius/
RUN cd aurelius && npm ci
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci

COPY aurelius aurelius
COPY frontend frontend

# Prisma client for the backend modules the API routes import.
RUN cd aurelius && npx prisma generate

# NEXT_PUBLIC_* is baked at BUILD time — Railway passes service variables
# as build args to Dockerfile builds; declare them so the bake happens.
ARG NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

RUN cd frontend && npm run build

WORKDIR /app/frontend
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start"]
